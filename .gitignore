# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local / generated OVERHAUL datasets
/data/raw/
/data/processed/
/data/tmp/

# dataset binaries must never be committed
*.parquet
*.nc
*.hdf5
*.h5
*.7z
*.zip
*.tar
*.tar.gz
*.csv
*.xlsx
*.xls
*.pdf
*.pt
*.pth
*.onnx
*.safetensors
